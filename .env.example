# Copy to .env (configure_assist.sh will create it for you on first run).
#
# HA_BASE_URL: where Home Assistant is reachable from this machine.
# Host network mode means HA listens directly on the host, so localhost works.
HA_BASE_URL=http://localhost:8123

# OLLAMA_BASE_URL: where Ollama is reachable from inside the HA container.
# Because HA runs in host network mode, "localhost" inside the container
# resolves to the host — same as outside. If you ever switch HA to bridge
# networking, change this to http://host.docker.internal:11434 and add
# extra_hosts to docker-compose.yml.
OLLAMA_BASE_URL=http://localhost:11434

# Long-Lived Access Token from Home Assistant.
# Generate at: http://localhost:8123/profile/security
# configure_assist.sh will prompt for this and write it back here.
HA_TOKEN=

# Ollama models to wire up as conversation agents.
# These are passed verbatim to the Ollama integration — they must already
# be pulled (`ollama list` to verify).
OLLAMA_MODELS=gemma4:e4b,qwen3.5:9b,ministral-3:8b
